{% macro print(message) %}{{ $message }}{% end_macro %}

{% macro banner(rows, columns, message) %}
    {% macro print from (macroTest.file) %}
    {% for (row = 0 to $rows) %}
        {% for (col = 0 to $columns) %}
            {% set printMessage = "$message => [$row, $col]" %}
            {{ print($printMessage) }}
        {% end_for %}
    {% end_for %}
{% end_macro %}
